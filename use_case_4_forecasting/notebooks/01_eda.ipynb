    "# Aggregate at Division level (primary modeling grain)\n",
    "weekly = (\n",
    "    vente.groupby(['week_ending','No. magasin','city','Division Code'])\n",
    "         .agg(sales=('Montant de la ligne','sum'),\n",
    "              units=('Quantité facturée','sum'),\n",
    "              n_transactions=('Montant de la ligne','count'))\n",
    "         .reset_index()\n",
    "         .rename(columns={'No. magasin':'store_code','Division Code':'division_code'})\n",
    ")\n",
    "weekly['sales'] = weekly['sales'].clip(lower=0)\n",
    "\n",
    "# Also aggregate at Catégorie level (saved separately for future use)\n",
    "weekly_cat = (\n",
    "    vente.groupby(['week_ending','No. magasin','city','Division Code','Catégorie'])\n",
    "         .agg(sales=('Montant de la ligne','sum'),\n",
    "              units=('Quantité facturée','sum'))\n",
    "         .reset_index()\n",
    "         .rename(columns={'No. magasin':'store_code','Division Code':'division_code',\n",
    "                           'Catégorie':'categorie'})\n",
    ")\n",
    "weekly_cat['sales'] = weekly_cat['sales'].clip(lower=0)\n",
    "\n",
    "print(f'Weekly (Division level) : {len(weekly):,} rows')\n",
    "print(f'Weekly (Catégorie level): {len(weekly_cat):,} rows')\n",
    "print(f'Weeks  : {weekly[\"week_ending\"].nunique()}')\n",
    "print(f'Stores : {weekly[\"store_code\"].nunique()}')\n",
    "print(f'Divs   : {weekly[\"division_code\"].nunique()}')\n",
    "\n",
    "MIN_WEEKS = 10\n",
    "g = weekly.groupby(['store_code','division_code'])['week_ending'].count().reset_index(name='n_weeks')\n",
    "print(f'\\nGroups with ≥ {MIN_WEEKS} weeks: {(g.n_weeks >= MIN_WEEKS).sum()} / {len(g)}')\n",
    "print(g[g.n_weeks >= MIN_WEEKS].sort_values('n_weeks', ascending=False).to_string(index=False))\n",
    "\n",
    "weekly.to_csv(DATA_PROCESSED / 'weekly_sales.csv', index=False)\n",
    "weekly_cat.to_csv(DATA_PROCESSED / 'weekly_sales_category.csv', index=False)\n",
    "print(f'\\n✅ Saved: weekly_sales.csv ({len(weekly):,} rows)')\n",
