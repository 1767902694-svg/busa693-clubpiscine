    "print(f'Fiscal years: {sorted(calendrier[\"FiscalYear\"].unique())}')\n",
    "\n",
    "# Verify our week_ending dates align perfectly with Fin de semaine\n",
    "vente['week_ending'] = vente['Date de Vente'] + pd.offsets.Week(weekday=6)\n",
    "our_weeks = set(vente['week_ending'].dt.normalize().unique())\n",
    "cal_weeks = set(calendrier['Fin de semaine'].dt.normalize().unique())\n",
    "missing   = our_weeks - cal_weeks\n",
    "\n",
    "print(f'\\nOur week_ending dates         : {len(our_weeks)}')\n",
    "print(f'Calendar Fin de semaine dates : {len(cal_weeks)}')\n",
    "print(f'Alignment check               : {\"✅ 100% match\" if not missing else f\"⚠️  {len(missing)} weeks not in calendar\"}')\n",
    "\n",
    "# Show the useful columns for Power BI enrichment\n",
    "CAL_JOIN_COLS = [\n",
    "    'Fin de semaine', 'FiscalYear', 'FiscalQuarter', 'FiscalMonthNum',\n",
    "    'FiscalMonth', '_Semaine fiscale NEW', 'CurWeekOffset', 'FutureDate'\n",
    "]\n",
    "cal_weekly = (\n",
    "    calendrier[CAL_JOIN_COLS]\n",
    "    .drop_duplicates(subset='Fin de semaine')\n",
    "    .sort_values('Fin de semaine')\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "print(f'\\nCalendar weekly lookup: {cal_weekly.shape}')\n",
    "print(cal_weekly.head(10).to_string(index=False))\n",
    "\n",
    "# Save calendar weekly lookup for downstream notebooks\n",
    "cal_weekly.to_csv(DATA_PROCESSED / 'calendar_weekly.csv', index=False)\n",
    "print('\\n✅ Saved: calendar_weekly.csv')"
   ]
